---
import Base from "../layouts/Base.astro";
---

<Base
  title="Home"
  description="Clientless is a new way to build apps where capabilities become personal interfaces."
>
  <section class="page hero gateway-hero">
    <div>
      <h1>Clientless</h1>
      <p>
        The traditional app container is disappearing. Developers publish
        capabilities. Users compose personal interfaces inside hosts like
        ChatGPT, Claude, the web, widgets, and whatever comes next.
      </p>
      <div class="hero-actions">
        <a class="button" href="/launch/">Read the launch page</a>
        <a class="button secondary" href="/docs/">Open the docs</a>
      </div>
    </div>
    <aside class="gateway-panel" aria-label="Site sections">
      <h2>Start here</h2>
      <div class="gateway-list">
        <a href="/launch/">
          <span class="route-chip" aria-hidden="true">01</span>
          <span>
            <strong>Launch</strong>
            The high-level argument for Clientless as the next app era.
          </span>
        </a>
        <a href="/docs/">
          <span class="route-chip blue" aria-hidden="true">02</span>
          <span>
            <strong>Docs</strong>
            The canonical definitions, capabilities model, hosts, and stack.
          </span>
        </a>
        <a href="/blog/">
          <span class="route-chip gold" aria-hidden="true">03</span>
          <span>
            <strong>Blog</strong>
            Essays that expand the thesis without replacing the docs.
          </span>
        </a>
      </div>
    </aside>
  </section>
</Base>
