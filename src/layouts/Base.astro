---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = `${title} | Clientless`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat+Alternates:wght@700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <nav class="nav" aria-label="Primary navigation">
          <a class="brand" href="/">
            <svg class="brand-mark" viewBox="0 0 128 128" aria-hidden="true">
              <rect width="128" height="128" rx="28"></rect>
              <text x="64" y="64" text-anchor="middle" dominant-baseline="middle">a</text>
              <text x="64" y="64" text-anchor="middle" dominant-baseline="middle">c</text>
            </svg>
            <span>Clientless</span>
          </a>
          <div class="nav-links">
            <a href="/launch/">Launch</a>
            <a href="/docs/">Docs</a>
            <a href="/blog/">Blog</a>
            <a href="/blog/rss.xml">RSS</a>
          </div>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <span>Clientless is the app model for a world after fixed clients.</span>
          <span>Capabilities become personal interfaces wherever the user needs them.</span>
        </div>
      </footer>
    </div>
  </body>
</html>
